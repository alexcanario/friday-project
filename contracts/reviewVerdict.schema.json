{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "changes_requested",
        "reject"
      ]
    },
    "headSha": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "answer": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "answer",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "required": [
    "verdict",
    "headSha",
    "rules",
    "findings",
    "risk"
  ],
  "additionalProperties": false
}
