{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "claim": {
            "type": "string"
          },
          "proof": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "command"
                  },
                  "command": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "command"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "browser"
                  },
                  "step": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "step"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "index",
          "claim",
          "proof"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "criteria"
  ],
  "additionalProperties": false
}
